        {
          "id": "6541a780-f65b-4828-90fa-5acda731f7d9",
          "name": "Port calls (arrivals and departures)",
          "request": {
            "name": "Port calls (arrivals and departures)",
            "description": {
              "content": "Retrieve historical port call events. Supply at least one of mmsi, or port_id/unloco, and either days or a fromdate/todate range (not both). Charged 5 credits per distinct date in the returned records.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "port",
                "calls"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "type",
                  "value": "0",
                  "description": "Filter: 0 all, 1 arrivals, 2 departures."
                },
                {
                  "disabled": false,
                  "key": "port_id",
                  "value": "<integer>",
                  "description": "Port identifier (mutually exclusive with unloco)."
                },
                {
                  "disabled": false,
                  "key": "unloco",
                  "value": "<string>",
                  "description": "Port UN/LOCODE (mutually exclusive with port_id)."
                },
                {
                  "disabled": false,
                  "key": "mmsi",
                  "value": "<integer>",
                  "description": "9-digit vessel identifier."
                },
                {
                  "disabled": false,
                  "key": "days",
                  "value": "<integer>",
                  "description": "Lookback period in days. Provide either days OR fromdate/todate."
                },
                {
                  "disabled": false,
                  "key": "fromdate",
                  "value": "<dateTime>",
                  "description": "Start datetime in UTC (ISO 8601)."
                },
                {
                  "disabled": false,
                  "key": "todate",
                  "value": "<dateTime>",
                  "description": "End datetime in UTC (ISO 8601)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
